# Copy this file to .env and fill in your own values. Never commit .env.

# Telegram bot (used by BOTH v1 and v2). See README for BotFather steps.
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenHere
TELEGRAM_CHAT_ID=123456789

# GoLogin Web Unlocker key (used by v2 only). Free trial = 1,000 requests.
GOLOGIN_WEBUNLOCKER_API_KEY=your_web_unlocker_key_here
